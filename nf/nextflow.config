/*
 * COSAP-NX configuration
 * Resources come from the pipeline JSON (per step, or "defaults").
 */

params {
    defaults = [cpus: 4, memory: '8 GB']
}

process {
    // No automatic retries (matching COSAP behavior)
    errorStrategy = 'terminate'
    maxRetries = 0
}

trace {
    enabled = true
    file = "${params.outdir}/logs/trace.txt"
    fields = 'task_id,name,status,exit,cpus,memory,realtime,%cpu,peak_rss'
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/logs/report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.outdir}/logs/timeline.html"
    overwrite = true
}

profiles {
    docker {
        includeConfig 'conf/docker.config'
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
}

manifest {
    name = 'cosap-nx'
    author = 'COSAP-NX Team'
    description = 'COSAP-like pipeline with Nextflow backend'
    version = '0.3.0'
    nextflowVersion = '>=23.04.0'
}
